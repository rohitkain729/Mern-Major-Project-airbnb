    <div class="card form-card">
      <h3 class="card title text-center mt-3 edit-title">Edit  Listing</h3>
    <div class="row d-block">
      <div class="col-9 card-body">
        <div>
          <label for="title" class="form-label link-primary">Title</label>
          <input
            type="text"
            name="listing[title]"
            id="title"
           value="<%=listing.title%>"
            class="form-control"
          />
        </div>

        <div>
          <label for="description" class="form-label link-primary">Description</label>
          <textarea
            id="description"
            name="listing[description]"
            class="form-control"
          ><%=listing.description%></textarea>
        </div>

        <div class="mt-2 mb-2">
          <img src="<%=originalImage%>" alt="Image">
        </div>

        <div>
          <label for="image" class="form-label link-primary">Upload New Image</label>
          <input
            type="file"
            name="listing[image][url]"
            id="image"
            class="form-control"
          />
        </div>

        <div class="row p-0 m-0">
          <div class="col-md-4 col-sm">
            <label for="price" class="form-label link-primary">Price</label>
            <input
              type="number"
              name="listing[price]"
              id="price"
             value="<%=listing.price%>"
              class="form-control"
            />
          </div>

          <div class="col-md-8 col-sm">
            <label for="location" class="form-label link-primary">Location</label>

            <input
              type="text"
              name="listing[location]"
              id="location"
              value="<%=listing.location%>"
              class="form-control"
            />
          </div>
        </div>

        <div>
          <label for="country" class="form-label link-primary">Country</label>
          <input
            type="text"
            name="listing[country]"
            id="country"
            value="<%=listing.country%>"
            class="form-control"
          />
        </div>
        <button class="btn btn-dark text-white fw-medium  mt-3 save-btn">Update</button>
      </div>
    </div>
    </div>



    </form>
  </body>
