<% layout("/layouts/boilerplate")%>
  <body>
    <!-- <h3>Edit your Listing</h3> -->
    <form action="/listings/<%=listing._id%>/update?_method=PUT" method="POST" enctype="multipart/form-data">


      <!-- <input type="text" name="listing[title]" id=""  value="<%=listing.title%>"/><br>
      <textarea
        id="description"
        name="listing[description]" rows="4" cols="55"
      ><%=listing.description%></textarea><br>
      <input type="text" name="listing[image]" id="" value="<%=listing.image.url%>" /><br>
