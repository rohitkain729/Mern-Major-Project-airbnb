<% layout("/layouts/boilerplate")%>
<body class="bg-body-tertiary">
  <form action="/listing" method="POST" class="form-style needs-validation"  novalidate>
    <div class="card form-card">
      <h3 class="card title text-center mt-3 edit-title">Create New Listing</h3>
      <div class="row d-block">
        <div class="col-9 card-body">
          <div>
            <label for="title" class="form-label link-primary">Title</label>
            <input
              type="text"
              name="listing[title]"
              id="title"
              class="form-control"
              required
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please choose a Title.</div>
          </div>

          <div>
            <label for="description" class="form-label link-primary"
              >Description</label
            >
            <textarea
              id="description"
              name="listing[description]"
              class="form-control"
              required
            ></textarea>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please choose a Description.</div>
          </div>

          <div>
            <label for="image" class="form-label link-primary">Image URL</label>
            <input
              type="text"
              name="listing[image][url]"
              id="image"
              class="form-control"
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please choose a Image.</div>
          </div>

          <div class="row p-0 m-0">
            <div class="col-md-4 col-sm">
              <label for="price" class="form-label link-primary">Price</label>
              <input
                type="text"
                name="listing[price]"
                id="price"
                class="form-control"
                required
              />
              <div class="valid-feedback">Looks good!</div>
              <div class="invalid-feedback">Please choose a Price.</div>
            </div>

            <div class="col-md-8 col-sm">
              <label for="location" class="form-label link-primary"
                >Location</label
              >

              <input
                type="text"
                name="listing[location]"
                id="location"
                class="form-control"
                required
              />
              <div class="valid-feedback">Looks good!</div>
              <div class="invalid-feedback">Please choose a Location.</div>
            </div>
          </div>

          <div>
            <label for="country" class="form-label link-primary">Country</label>
            <input
              type="text"
              name="listing[country]"
              id="country"
              class="form-control"
              required
            />
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please choose a Country.</div>
          </div>
          <button class="btn btn-dark text-white fw-medium mt-3 save-btn" type="submit">
            Add
          </button>
        </div>
      </div>
    </div>
  </form>
</body>
