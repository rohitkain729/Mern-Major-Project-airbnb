<% layout("/layouts/boilerplate")%>
<body>
    <div class="card text-center show-card">
  <div class="card-header  fw-medium font-monospace show-card-title">
    <%= listing.title %>
  </div>
  <img src="<%= listing.image.url%>" class="card-img-top show-img" alt="Listing">
  <div class="card-body">
    <div class="card-text mb-3" style="margin-left: -28rem;font-weight: 500;">
      Owned By : <%=listing.owner.username.charAt(0).toUpperCase()+listing.owner.username.slice(1)%>
    </div>
    <h5 class="card-title"><%= listing.description %></h5>
    <div class="row ms-5">
        <div class="col-3">
            <p class="card-text fw-medium">Country:<%= listing.country %></p>
        </div>
        <div class="col-5">
            <h5 class="card-title fw-medium fs-6">Location: <%= listing.location %></h5>
        </div>
        <div class="col-3">
            <p class="card-text fw-medium">Price: &#8377 <%= listing.price.toLocaleString("en-IN") %></p>
        </div>
    </div>

   <% if( currUser &&currUser._id.equals(listing.owner._id)){ %>
    <a href="/listings/<%=listing._id%>/edit" class="btn btn-outline-primary text-black mt-2 d-inline-block">Edit Listing</a>

    <form action="/listings/<%=listing._id%>?_method=DELETE" method="POST" class="d-inline-block">
        <button class="btn btn-danger text-white mt-2 " type="submit">Delete</button>
    </form>
  <% } %>
    <!-- <a href="/listings/<%=listing._id%>?_method=DELETE" class="btn btn-danger text-white mt-2">delete Listing</a> -->
  </div>

  <hr class="mb-5">
  <div class="review-area">
    <h5 class="mb-2 mt-2 review-heading bg-dark text-white">Leave a Review</h5>

    <form
  action="/listings/<%= listing.id %>/reviews"
  class="needs-validation mt-4"
  method="POST"
  novalidate
>
  <!-- Rating -->
  <div class="mb-4">
    <label
      for="rating"
      class="form-label bg-dark text-white px-3 py-2 rounded"
    >
      Rating
    </label>

    <input
      type="range"
      min="1"
      max="5"
      step="1"
      value="3"
      name="review[rating]"
      id="rating"
      class="form-range w-50"
    />

    <div class="d-flex justify-content-between w-50 px-1 range-numbers">
      <span>1</span>
      <span>2</span>
      <span>3</span>
      <span>4</span>
      <span>5</span>
    </div>
  </div>

  <!-- Comment -->
  <div class="mb-3">
    <label
      for="comment"
      class="form-label bg-dark text-white px-3 py-2 rounded"
    >
      Comments
    </label>

    <textarea
      name="review[comment]"
      id="comment"
      rows="3"
      
      class="form-control border-info"
      placeholder="Write your review here..."
      required
    ></textarea>

    <div class="valid-feedback">
      Looks good!
    </div>

    <div class="invalid-feedback">
      Please enter comments.
    </div>
  </div>

  <!-- Submit Button -->
  <button class="btn btn-success px-4" type="submit">
    Submit Review
  </button>
</form>

<hr>
<h4>All Reviews</h4>

<!-- <span><%=listing.reviews%></span> -->
 

<div class="row row-cols-3 review">
<% for(review of listing.reviews){ %>

  <div class="col review-col mb-3">
    <div class="d-flex justify-content-start gap-5">

      <span class="card-title">Binda Soni</span>
      <span class="review-rating">Rating: <%=review.rating%><i class="fa-solid fa-star"></i></span>
     
    </div>
    <span class="mb-5"> Comment: <%=review.comment%></span>
     <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="review-del-btn " method="POST">
        <button class="btn btn-dark btn-sm">Delete</button>
      </form>

</div>
<% } %>
</div>

  </div>
 
</div>
    
</body>

